# AMERB AI — settings for the Docker Compose setup.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d
#
# (Naming the file `.env` also works — Compose reads it automatically — but the project's
# existing `.env` belongs to the non-Docker start.bat/start.sh setup, so use a separate file.)
#
# Every variable is optional; the defaults shown are used when a line is missing or left empty.
# These values reach the containers only through docker-compose.yml's `environment:` section.
# OLLAMA_URL, IMAGEGEN_URL, HOST and the container-side port are fixed there on purpose and
# cannot be set from this file.
# Do not put quotes or trailing comments on the value lines.

# ---------------------------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------------------------

# Port on THIS machine that staff open:  https://<this-machine>:PORT
PORT=3000

# Which host network interface the port is bound to. 0.0.0.0 = reachable from the whole network.
# Use 127.0.0.1 to allow this machine only (e.g. when a reverse proxy runs on the same host).
BIND_ADDRESS=0.0.0.0

# IMPORTANT: names/IPs staff will type in the browser, comma-separated, e.g.
#   PUBLIC_HOSTNAMES=10.0.0.25,amerb.bank.local
# They are added to the self-signed HTTPS certificate. Inside Docker the app cannot discover the
# host's LAN IP, so without this the certificate only covers localhost and the container name.
# Changing it later regenerates the certificate (every PC that trusted it must trust the new one).
PUBLIC_HOSTNAMES=

# Secret that signs login cookies. Leave EMPTY (recommended): a random one is generated on first
# start and kept in the amerb-data volume, so it survives restarts and upgrades. To set your own:
#   openssl rand -hex 32
# Changing it signs everybody out.
SESSION_SECRET=

# ---------------------------------------------------------------------------------------------
# Models (downloaded automatically by the one-shot `ollama-pull` service on first `up`)
# ---------------------------------------------------------------------------------------------

# Default chat model. A few GB; must exist in the Ollama library (https://ollama.com/library).
DEFAULT_MODEL=qwen3:4b-instruct

# Small embedding model that makes document search work by meaning (~270 MB).
EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------------------------
# Ollama tuning (resource usage)
# ---------------------------------------------------------------------------------------------

# How long a model stays loaded in memory after its last request: 5m, 30m, 2h, -1 (forever), 0 (unload at once).
# Longer = faster replies after idle periods, but RAM stays occupied.
OLLAMA_KEEP_ALIVE=30m

# Requests Ollama handles in parallel per model. Each adds memory use. 1 suits a small CPU-only
# server; raise to 2-4 for many simultaneous users if there is RAM/VRAM to spare.
OLLAMA_NUM_PARALLEL=1

# How many models may be in memory at once. 2 = chat model + embedding model.
OLLAMA_MAX_LOADED_MODELS=2

# Context window (tokens) the app requests from every model. Larger = longer chats/documents but more RAM.
OLLAMA_NUM_CTX=8192

# Docker image for Ollama. Pin a version (e.g. ollama/ollama:0.12.0) for fully repeatable deployments.
OLLAMA_IMAGE=ollama/ollama:latest

# ---------------------------------------------------------------------------------------------
# Image generation (only used with:  docker compose --profile imagegen up -d)
# ---------------------------------------------------------------------------------------------

# Hugging Face model id. The default is ~5 GB and is downloaded on first start.
IMAGEGEN_MODEL=stabilityai/sd-turbo

# ---------------------------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------------------------

# Application log (rotating files in the amerb-logs volume): debug, info, warn or error.
LOG_LEVEL=info
# Size of each application log file in MB, and how many rotated files to keep.
LOG_MAX_MB=10
LOG_KEEP=5

# Docker's own per-container log (`docker compose logs`) rotation: max size per file / number of files.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
