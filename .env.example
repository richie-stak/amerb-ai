PORT=3000
# 0.0.0.0 = reachable from other computers on the network at https://<this machine's IP>:PORT.
# Use 127.0.0.1 to allow only this computer.
HOST=0.0.0.0
# Extra names staff will use to reach this server, comma-separated, added to the HTTPS
# certificate — e.g. a fixed IP or DNS name: PUBLIC_HOSTNAMES=10.0.0.25,amerb.bank.local
PUBLIC_HOSTNAMES=
# start.bat / start.sh fill this in with a random value automatically when creating .env.
SESSION_SECRET=change-this-to-a-random-string
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen3:4b-instruct
# Small local model that lets document search match by meaning, not just exact words.
EMBED_MODEL=nomic-embed-text
IMAGEGEN_URL=http://127.0.0.1:7861

# --- Logging ---------------------------------------------------------------
# Where the structured log (amerb-ai.log, JSON lines) and service.log go.
# LOG_DIR=logs
# debug | info | warn | error
# LOG_LEVEL=info
# Rotate at this size (MB) and keep this many old files.
# LOG_MAX_MB=10
# LOG_KEEP=5

# --- Queue & rate limits (defaults shown) ----------------------------------
# Everything below can also be changed live in Admin -> Operations.
# How many answers the local model works on at once (one machine, so this is small).
# CHAT_CONCURRENCY=2
# How many people may wait in line at once; beyond this they're told to try again shortly.
# CHAT_MAX_WAITING=30
# How many messages one person may have answering or waiting at once.
# CHAT_PER_USER=2
# When a model fails, DEFAULT_MODEL is tried last. Set to "off" to only use the list configured in
# Admin -> Model routing.
# AMERB_DEFAULT_FALLBACK=on

# --- Language ---------------------------------------------------------------
# Reply language (English / Twi / Ga) is set in the app, not here: Workspace -> Reply language for
# each person, Admin -> Tools -> Language for the bank-wide default and the glossary.
# Voice input uses this Whisper model. The default is English-only — Whisper has no Twi/Ga support,
# so pointing this at a fine-tuned multilingual model is the only way to change that.
# SPEECH_MODEL=Xenova/whisper-tiny.en

# --- Web search & exchange rates -------------------------------------------
# DuckDuckGo (the default) now answers this kind of server with an anti-bot page, so web search can
# fail with "the provider refused the request". Point SEARXNG_URL at a self-hosted SearXNG instance
# to search reliably from inside the bank's network (see README "Web search").
# SEARXNG_URL=http://127.0.0.1:8888
# The exchange-rate tool's service. The bank's authorised exchangerate-api.com account (v6) is recommended:
# put the key in .env only (it is gitignored) — never in the repository or a document.
# EXCHANGE_RATE_URL=https://v6.exchangerate-api.com/v6/<your-api-key>/latest/USD
# Without this, the tool falls back to the free open.er-api.com service.

# --- Production hardening ---------------------------------------------------
# The e-mail address that becomes the bank's first administrator when it signs up. Set it once, before
# the first deployment, then remove it. Without it nobody is an admin, and no username (including
# "admin") is ever promoted automatically.
# BOOTSTRAP_ADMIN_EMAIL=first.admin@amenfimanbank.com

# Behind a reverse proxy (nginx, Caddy, a load balancer): the real client address arrives in
# X-Forwarded-For. Set this to the number of proxies in front (usually 1) or "true" for a trusted local
# proxy, otherwise audit entries, lockouts and rate limits all see the proxy's address.
# TRUST_PROXY=1

# Sign-in / sign-up throttle per address (default 30 attempts per 15 minutes).
# AUTH_RATE_MAX=30
# AUTH_RATE_WINDOW_MS=900000

# Voice input: on a Windows server that ships its own onnxruntime.dll, the speech model's runtime
# conflicts with it. Set SPEECH_DISABLED=1 to hide the microphone, or SPEECH_FORCE=1 if the versions
# have been checked and load correctly.
# SPEECH_DISABLED=1
# SPEECH_FORCE=1

# Web search endpoints (advanced). By default the app tries DuckDuckGo's HTML page, then its
# lightweight page, then Bing News RSS. Setting AMERB_SEARCH_URL alone uses only that provider.
# AMERB_SEARCH_LITE_URL=https://lite.duckduckgo.com/lite/
# AMERB_BING_NEWS_URL=https://www.bing.com/news/search

# Document branding: the PNG logo placed on generated Word/PDF/Excel/PowerPoint files.
# Default: assets/branding/community-bank-logo.png (relative to the app folder).
# AMERB_LOGO_PATH=C:\path\to\logo.png
