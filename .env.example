PORT=3000
# 0.0.0.0 = reachable from other computers on the network at https://<this machine's IP>:PORT.
# Use 127.0.0.1 to allow only this computer.
HOST=0.0.0.0
# Extra names staff will use to reach this server, comma-separated, added to the HTTPS
# certificate — e.g. a fixed IP or DNS name: PUBLIC_HOSTNAMES=10.0.0.25,amerb.bank.local
PUBLIC_HOSTNAMES=
# start.bat / start.sh fill this in with a random value automatically when creating .env.
SESSION_SECRET=change-this-to-a-random-string
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen3:4b-instruct
IMAGEGEN_URL=http://127.0.0.1:7861
