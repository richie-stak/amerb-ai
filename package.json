{
  "name": "amerb-ai",
  "version": "1.0.0",
  "description": "AMERB AI - a locally hosted Claude-style chat app powered by a local LLM (Ollama)",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-concurrency=1",
    "test:fast": "node --test --test-concurrency=2",
    "service:install": "node scripts/service/install.js",
    "service:repair": "node scripts/service/repair.js",
    "service:uninstall": "node scripts/service/uninstall.js",
    "service:status": "node scripts/service/status.js",
    "network:info": "node scripts/networking.js"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@huggingface/transformers": "^3.8.1",
    "bcryptjs": "^2.4.3",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "katex": "^0.19.1",
    "mammoth": "^1.12.1",
    "mathjs": "^15.2.0",
    "multer": "^2.2.0",
    "node-windows": "^1.0.0-beta.8",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "selfsigned": "^5.5.0",
    "tesseract.js": "^7.0.0",
    "undici": "^7.29.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "qs": "^6.16.1",
    "uuid": "^11.1.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
